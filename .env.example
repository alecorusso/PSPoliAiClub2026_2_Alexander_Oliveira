# Chave da API do Google Gemini (Google AI Studio: https://aistudio.google.com/apikey)
# Se esta variavel NAO estiver definida, o servidor opera em modo mock:
# todas as funcoes de IA retornam dados simulados com atraso artificial
# e a aplicacao continua funcionando normalmente.
GEMINI_API_KEY=

# Modelo usado nas chamadas (opcional, padrao: gemini-flash-latest).
# Use "latest" para nao quebrar quando uma versao fixa for aposentada.
GEMINI_MODELO=gemini-flash-latest

# Porta do servidor Express (opcional, padrao: 3333)
PORT=3333
